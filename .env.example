# Database Configuration
# PostgreSQL example: postgresql://username:password@localhost:5432/paralipay_db
# SQLite example: sqlite:///./paralipay.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/paralipay_db

# JWT & Security
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage for Verification Documents
UPLOAD_DIR=./uploads/verification_docs
